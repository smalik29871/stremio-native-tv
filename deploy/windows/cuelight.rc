// The .exe's icon and the name Windows shows for it (Properties, Task Manager)
#include <winver.h>
1 ICON "cuelight.ico"
1 VERSIONINFO
FILEVERSION     SNTV_VER_MAJOR,SNTV_VER_MINOR,SNTV_VER_PATCH,0
PRODUCTVERSION  SNTV_VER_MAJOR,SNTV_VER_MINOR,SNTV_VER_PATCH,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Cuelight"
      VALUE "FileDescription", "Cuelight"
      VALUE "ProductName", "Cuelight"
      VALUE "ProductVersion", SNTV_VER_STRING
      VALUE "FileVersion", SNTV_VER_STRING
      VALUE "LegalCopyright", "Copyright (c) 2026 Shahrukh. All rights reserved."
      VALUE "OriginalFilename", "Cuelight.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
