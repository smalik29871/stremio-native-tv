# Writes this version's CHANGELOG.md section as C strings: the app's "What's new" after an
# update, and Settings > About. Run by the build (cmake -P) whenever either file changes.
#   cmake -DSRC=<repo> -DOUT=<file.h> -P tools/whatsnew.cmake
file(READ "${SRC}/src/platform/platform.h" platform)
string(REGEX MATCH "SNTV_APP_VERSION \"([0-9.]+)\"" _ "${platform}")
set(version "${CMAKE_MATCH_1}")
file(READ "${SRC}/CHANGELOG.md" log)
string(FIND "${log}" "\n## ${version}\n" at)
set(heading "## ${version}\n")
if(at EQUAL -1)   # a build between releases: the notes so far
  string(FIND "${log}" "\n## Unreleased\n" at)
  set(heading "## Unreleased\n")
endif()
set(body "")
if(NOT at EQUAL -1)
  string(LENGTH "${heading}" hl)
  math(EXPR from "${at} + 1 + ${hl}")
  string(SUBSTRING "${log}" ${from} -1 rest)
  string(FIND "${rest}" "\n## " stop)
  if(stop EQUAL -1)
    set(body "${rest}")
  else()
    string(SUBSTRING "${rest}" 0 ${stop} body)
  endif()
  string(STRIP "${body}" body)
endif()
string(REPLACE "\\" "\\\\" body "${body}")
string(REPLACE "\"" "\\\"" body "${body}")
string(REPLACE "\n" "\\n\"\n    \"" body "${body}")
set(text "/* generated from CHANGELOG.md by tools/whatsnew.cmake */\nstatic const char WHATSNEW_VERSION[] = \"${version}\";\nstatic const char WHATSNEW[] =\n    \"${body}\";\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  if(old STREQUAL text)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${text}")
